  ['apple', 'macos-dmg', '', 'arm64', 'apple', true],
  ['intel', 'macos-dmg', '', 'x64', 'cpu', false]
] as const
---

<section
  class="download-hub"
  data-download-hub
  data-catalog-url={catalogUrl}
  data-download-label={copy.download}
  data-unavailable-label={copy.unavailable}
  data-volume-one-label={copy.volume1}
  data-volume-two-label={copy.volume2}
  data-release-label={copy.release}
  data-error-label={copy.error}
  aria-labelledby="download-hub-title"
  aria-busy="true"
>
  <div class="download-hub-inner">
    <header class="download-hub-hero">
      <img src="/logo.svg" alt="" width="82" height="82" />
      <div>
        <p>LizzieYzy Next</p>
        <h1 id="download-hub-title">{copy.title}</h1>
        <span>{copy.lead}</span>
      </div>
      <div class="release-status" data-release-status role="status">{copy.loading}</div>
    </header>

    <div class="download-error" data-download-error hidden role="alert">
      <strong>{copy.error}</strong>
      <div>
        <button type="button" data-download-retry>{copy.retry}</button>
        <a href={releaseHistory}>{copy.openDirect}</a>
      </div>
    </div>

    <div class="download-platform-grid">
      <section class="download-platform-panel" aria-labelledby="windows-downloads">
        <header class="platform-heading">
          <img src="/images/download-icons/windows.svg" alt="" width="30" height="30" />
          <div><h2 id="windows-downloads">Windows</h2><p>{copy.windowsLead}</p></div>
        </header>
        <ul class="download-option-list">
          {rows.map(([key, category, flavor, arch, icon, recommended]) => (
            <li class="download-option" data-entry data-category={category} data-flavor={flavor} data-arch={arch} data-multipart={key === 'tensorrt' ? 'true' : 'false'}>
              <div class="option-main">
                <img src={`/images/download-icons/${icon}.svg`} alt="" width="31" height="31" />
                <div>
                  <h3>{copy.rows[key][0]} {recommended && <span>{copy.recommended}</span>}</h3>
                  <p>{copy.rows[key][1]}</p>
                </div>
              </div>
              <span class="option-size" data-size>—</span>
              <div class="option-actions">
                <a data-action="0" hidden aria-disabled="true"></a>
                <a data-action="1" hidden aria-disabled="true"></a>
                <span data-unavailable hidden>{copy.unavailable}</span>
              </div>
            </li>
          ))}
        </ul>
      </section>

      <section class="download-platform-panel mac-panel" aria-labelledby="mac-downloads">
        <header class="platform-heading">
          <img src="/images/download-icons/apple.svg" alt="" width="30" height="30" />
          <div><h2 id="mac-downloads">macOS</h2><p>{copy.macLead}</p></div>
        </header>
        <ul class="download-option-list">
          {macRows.map(([key, category, flavor, arch, icon, recommended]) => (
            <li class="download-option" data-entry data-category={category} data-flavor={flavor} data-arch={arch}>
              <div class="option-main">
                <img src={`/images/download-icons/${icon}.svg`} alt="" width="31" height="31" />
                <div>
                  <h3>{copy.rows[key][0]} {recommended && <span>{copy.recommended}</span>}</h3>
                  <p>{copy.rows[key][1]}</p>
                </div>
              </div>
              <span class="option-size" data-size>—</span>
              <div class="option-actions">
                <a data-action="0" hidden aria-disabled="true"></a>
                <a data-action="1" hidden aria-disabled="true"></a>
                <span data-unavailable hidden>{copy.unavailable}</span>
              </div>
            </li>
          ))}
        </ul>
        <p class="mac-install-tip">{copy.macTip}</p>
      </section>
    </div>

    <section class="core-update" data-entry data-category="windows-core-update" data-flavor="all" aria-label={copy.updateTitle}>
      <img src="/images/download-icons/arrow-repeat.svg" alt="" width="31" height="31" />
      <div><strong>{copy.updateTitle}</strong><span>{copy.updateText} · <span data-size>—</span></span></div>
      <div class="option-actions">
        <a data-action="0" hidden aria-disabled="true">{copy.updateAction}</a>
        <a data-action="1" hidden aria-disabled="true"></a>
        <span data-unavailable hidden>{copy.unavailable}</span>
      </div>
    </section>

    <nav class="download-support" aria-label="Download support">
      <a href={helpUrl}><img src="/images/download-icons/book.svg" alt="" width="18" height="18" />{copy.help}</a>
      <a href={releaseHistory}><img src="/images/download-icons/clock-history.svg" alt="" width="18" height="18" />{copy.history}</a>
    </nav>

    <noscript><p class="noscript-note"><a href={releaseHistory}>{copy.openDirect}</a></p></noscript>
  </div>
</section>

<script is:inline>
  (() => {
    const allowedHosts = new Set(['download.goagent.top', 'github.com'])
    const catalogFetchAttempts = 3
    const catalogRetryBaseDelayMs = 450

    function wait(milliseconds) {
      return new Promise((resolve) => window.setTimeout(resolve, milliseconds))
    }

    async function fetchCatalogWithRetry(url) {
      let lastError
      for (let attempt = 1; attempt <= catalogFetchAttempts; attempt += 1) {
        try {
          const response = await fetch(url, { cache: 'no-store', headers: { Accept: 'application/json' } })
          if (!response.ok) throw new Error(`HTTP ${response.status}`)
          const catalog = await response.json()
          if (catalog.schemaVersion !== 1 || !Array.isArray(catalog.assets) || !catalog.releaseTag) {
            throw new Error('Invalid catalog')
          }
          return catalog
        } catch (error) {
          lastError = error
          if (attempt < catalogFetchAttempts) {
            await wait(catalogRetryBaseDelayMs * attempt)
          }
        }
      }
      throw lastError
    }

    function formatSize(bytes) {
      if (!Number.isFinite(bytes) || bytes <= 0) return '—'
      const units = ['B', 'KB', 'MB', 'GB']
      let value = bytes
      let unit = 0
      while (value >= 1024 && unit < units.length - 1) {
        value /= 1024
        unit += 1
      }
      return `${value.toFixed(unit === 0 ? 0 : 1)} ${units[unit]}`
    }

    function safeDownloadUrl(value) {
      try {
        const url = new URL(value)
        return url.protocol === 'https:' && allowedHosts.has(url.hostname) ? url.href : null
      } catch {
        return null
      }
    }

    function findAssets(catalog, entry) {
      const category = entry.dataset.category || ''
      const flavor = entry.dataset.flavor || ''
      const arch = entry.dataset.arch || ''
      return catalog.assets.filter((asset) =>
        asset.category === category &&
        (!flavor || asset.flavor === flavor) &&
        (!arch || asset.arch === arch)
      )
    }

    function fillEntry(hub, entry, catalog) {
      const actions = Array.from(entry.querySelectorAll('[data-action]'))
      const unavailable = entry.querySelector('[data-unavailable]')
      const size = entry.querySelector('[data-size]')
      let assets = findAssets(catalog, entry)
      if (entry.dataset.multipart === 'true') {
        assets = assets.filter((asset) => /\.7z\.\d{3}$/.test(asset.name)).sort((a, b) => a.name.localeCompare(b.name))
      } else {
        assets = assets.slice(0, 1)
      }

      actions.forEach((action) => {
        action.hidden = true
        action.removeAttribute('href')
        action.setAttribute('aria-disabled', 'true')
      })

      const usable = assets
        .map((asset) => ({ asset, url: safeDownloadUrl(asset.downloadUrl) }))
        .filter((item) => item.url)

      if (!usable.length) {
        if (unavailable) unavailable.hidden = false
        if (size) size.textContent = '—'
        return
      }

      if (unavailable) unavailable.hidden = true
      if (size) size.textContent = formatSize(usable.reduce((total, item) => total + Number(item.asset.sizeBytes || 0), 0))
      usable.slice(0, actions.length).forEach((item, index) => {
        const action = actions[index]
        action.href = item.url
        action.hidden = false
        action.removeAttribute('aria-disabled')
        if (entry.dataset.multipart === 'true') {
          action.textContent = index === 0 ? hub.dataset.volumeOneLabel : hub.dataset.volumeTwoLabel
        } else if (!action.textContent.trim()) {
          action.textContent = hub.dataset.downloadLabel
        }
        const title = entry.querySelector('h3')?.childNodes[0]?.textContent?.trim() || ''
        action.setAttribute('aria-label', `${action.textContent} ${title}`.trim())
      })
    }

    async function loadCatalog(hub) {
      const error = hub.querySelector('[data-download-error]')
      const status = hub.querySelector('[data-release-status]')
      hub.setAttribute('aria-busy', 'true')
      if (error) error.hidden = true
      try {
        const catalog = await fetchCatalogWithRetry(hub.dataset.catalogUrl)
        hub.querySelectorAll('[data-entry]').forEach((entry) => fillEntry(hub, entry, catalog))
        if (status) status.textContent = `${hub.dataset.releaseLabel} · ${catalog.releaseTag}`
      } catch {
        if (status) status.textContent = hub.dataset.errorLabel
        if (error) error.hidden = false
      } finally {
        hub.setAttribute('aria-busy', 'false')
      }
    }

    document.querySelectorAll('[data-download-hub]').forEach((hub) => {
      hub.querySelector('[data-download-retry]')?.addEventListener('click', () => loadCatalog(hub))
      loadCatalog(hub)
    })
  })()
</script>

<style>
  .download-hub {
    width: 100vw;
    margin: 0 calc(50% - 50vw);
    border-bottom: 1px solid rgba(81, 60, 31, 0.14);
    background: #f8f5ed url('/images/download-page-bg.webp') top center / cover fixed no-repeat;
  }

  .download-hub-inner {
    width: min(1280px, calc(100% - 48px));
    margin: 0 auto;
    padding: 54px 0 44px;
  }

  .download-hub-hero {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 22px;
    margin-bottom: 30px;
  }

  .download-hub-hero > img {
    width: 82px;
    height: 82px;
    border-radius: 22px;
    box-shadow: 0 12px 30px rgba(71, 52, 22, 0.16);
  }

  .download-hub-hero p,
  .download-hub-hero h1,
  .download-hub-hero span {
    margin: 0;
  }

  .download-hub-hero p {
    color: #204f43;
    font-family: Georgia, 'Times New Roman', 'Songti SC', serif;
