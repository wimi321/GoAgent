    windowsLead: 'Dùng CUDA cho NVIDIA RTX 20 / 30 / 40 / 50; RX 9000 có thể thử ROCm, các GPU khác dùng OpenCL', macLead: 'Chọn bản phù hợp với chip Mac', download: 'Tải xuống', recommended: 'Khuyên dùng',
    unavailable: 'Chưa có', volume1: 'Phần 1', volume2: 'Phần 2', macTip: 'Sau khi tải, kéo ứng dụng vào Applications', updateTitle: 'Đã dùng bản portable?',
    updateText: 'Chỉ cập nhật chương trình', updateAction: 'Bản cập nhật nhỏ', help: 'Hướng dẫn cài', history: 'Phiên bản cũ', error: 'Không tải được danh sách phiên bản. Hãy thử lại.',
    retry: 'Tải lại', openDirect: 'Mở bản tải dự phòng trên GitHub', amdMore: 'Các bản thử nghiệm RX 6000 / RX 7000 / Ryzen AI Max có trên GitHub. Nếu không chắc, hãy dùng OpenCL.', amdMoreAction: 'Các bản AMD thử nghiệm khác',
    rows: { nvidia: ['NVIDIA CUDA', 'Một bản cho RTX 20 / 30 / 40 / 50'], amd: ['AMD RX 9000', 'ROCm thử nghiệm · dòng RX 9060 / 9070'], tensorrt: ['TensorRT tùy chọn', 'RTX 30 / 40 / 50 ưu tiên CUDA vì thường nhanh hơn · TensorRT chỉ để tăng tốc RTX 20 / GTX 16 · không hỗ trợ GTX 10 · tải cả hai phần'], opencl: ['Tương thích OpenCL', 'Đồ họa AMD / Intel'], cpu: ['CPU phổ thông', 'Dùng được không cần GPU rời'], noEngine: ['Không kèm engine', 'Dùng KataGo riêng'], apple: ['Chip Apple', 'M1 / M2 / M3 / M4 / M5'], intel: ['Chip Intel', 'Mac Intel đời cũ'] }
  }
} as const

const copy = copyByLang[lang] ?? copyByLang.en
const home = homeCopy[lang]
const Heading = compact ? 'h2' : 'h1'
const localeSlug = { 'zh-CN': '', 'zh-Hant': 'zh-hant', en: 'en', ja: 'ja', ko: 'ko', th: 'th', vi: 'vi' }[lang]
const helpUrl = localeSlug ? `/${localeSlug}/docs` : '/docs'
const rows = [
  ['nvidia', 'windows-portable', 'nvidia', '', 'gpu-card', true],
  ['amd', 'amd-rocm-experimental', 'rocm-gfx120x', 'x64', 'gpu-card', false],
  ['opencl', 'windows-portable', 'opencl', '', 'gpu-card', false],
  ['cpu', 'windows-portable', 'with-katago', '', 'cpu', false],
  ['noEngine', 'windows-portable', 'without.engine', '', 'gear', false],
  ['tensorrt', 'tensorrt-optional', 'nvidia-tensorrt', '', 'speedometer', false]
] as const
const macRows = [
  ['apple', 'macos-dmg', '', 'arm64', 'apple', true],
  ['intel', 'macos-dmg', '', 'x64', 'cpu', false]
] as const
---

<section
  class:list={["download-hub", { compact }]}
  data-download-hub
  data-catalog-url={catalogUrl}
  data-loading-label={copy.loading}
  data-download-label={copy.download}
  data-unavailable-label={copy.unavailable}
  data-volume-one-label={copy.volume1}
  data-volume-two-label={copy.volume2}
  data-release-label={copy.release}
  data-error-label={copy.error}
  aria-labelledby="download-hub-title"
  aria-busy="true"
>
  <div class="download-hub-inner">
    <header class="download-hub-hero">
      <img src="/logo.svg" alt="" width="82" height="82" />
      <div>
        <p>LizzieYzy Next</p>
        <Heading id="download-hub-title">{title || copy.title}</Heading>
        <span>{lead || copy.lead}</span>
      </div>
      <div class="release-status" data-release-status role="status">{copy.loading}</div>
    </header>

    <div class="download-error" data-download-error hidden role="alert">
      <strong>{copy.error}</strong>
      <div>
        <button type="button" data-download-retry>{copy.retry}</button>
        <a href={releaseHistory}>{copy.openDirect}</a>
      </div>
    </div>

    <div class="download-tabs" data-platform-tabs role="tablist" aria-label={home.platformLabel} hidden>
      {(['windows', 'mac', 'linux'] as const).map((platform, index) => <button type="button" role="tab" id={`tab-${platform}`} aria-controls={`panel-${platform}`} aria-selected={index === 0 ? 'true' : 'false'} tabindex={index === 0 ? 0 : -1} data-platform-tab={platform}>
        <SiteIcon name={platform === 'mac' ? 'apple' : platform} />
        {platform === 'mac' ? 'macOS' : platform === 'windows' ? 'Windows' : 'Linux'}
      </button>)}
    </div>
    <div class="download-platform-grid">
      <section class="download-platform-panel" id="panel-windows" data-platform-panel="windows" role="tabpanel" aria-labelledby="tab-windows" tabindex="0">
        <header class="platform-heading">
          <img src="/images/download-icons/windows.svg" alt="" width="30" height="30" />
          <div><h2 id="windows-downloads">Windows</h2><p>{copy.windowsLead}</p></div>
        </header>
        <ul class="download-option-list">
          {rows.filter(([key]) => !compact || ['nvidia', 'opencl', 'cpu'].includes(key)).map(([key, category, flavor, arch, icon, recommended]) => (
            <li class="download-option" data-entry data-category={category} data-flavor={flavor} data-arch={arch} data-multipart={key === 'tensorrt' ? 'true' : 'false'}>
              <div class="option-main">
                <img src={`/images/download-icons/${icon}.svg`} alt="" width="31" height="31" />
                <div>
                  <h3>{copy.rows[key][0]} {recommended && <span>{copy.recommended}</span>}</h3>
                  <p>{copy.rows[key][1]}</p>
                </div>
              </div>
              <span class="option-size" data-size>—</span>
              <div class="option-actions">
                <a data-action="0" hidden aria-disabled="true"></a>
                <a data-action="1" hidden aria-disabled="true"></a>
                <span data-unavailable hidden>{copy.unavailable}</span>
              </div>
            </li>
          ))}
        </ul>
        {!compact && <aside class="amd-more" aria-label={copy.amdMore}>
          <span>{copy.amdMore}</span>
          <a href={releaseHistory} data-amd-release-link>{copy.amdMoreAction}</a>
        </aside>}
      </section>

      <section class="download-platform-panel mac-panel" id="panel-mac" data-platform-panel="mac" role="tabpanel" aria-labelledby="tab-mac" tabindex="0">
        <header class="platform-heading">
          <img src="/images/download-icons/apple.svg" alt="" width="30" height="30" />
          <div><h2 id="mac-downloads">macOS</h2><p>{copy.macLead}</p></div>
        </header>
        <ul class="download-option-list">
          {macRows.map(([key, category, flavor, arch, icon, recommended]) => (
            <li class="download-option" data-entry data-category={category} data-flavor={flavor} data-arch={arch}>
              <div class="option-main">
                <img src={`/images/download-icons/${icon}.svg`} alt="" width="31" height="31" />
                <div>
                  <h3>{copy.rows[key][0]} {recommended && <span>{copy.recommended}</span>}</h3>
                  <p>{copy.rows[key][1]}</p>
                </div>
              </div>
              <span class="option-size" data-size>—</span>
              <div class="option-actions">
                <a data-action="0" hidden aria-disabled="true"></a>
                <a data-action="1" hidden aria-disabled="true"></a>
                <span data-unavailable hidden>{copy.unavailable}</span>
              </div>
            </li>
          ))}
        </ul>
        <p class="mac-install-tip">{copy.macTip}</p>
      </section>
      <section class="download-platform-panel linux-panel" id="panel-linux" data-platform-panel="linux" role="tabpanel" aria-labelledby="tab-linux" tabindex="0">
        <SiteIcon name="linux" size={36} /><h2>Linux</h2><p>{home.linuxLead}</p>
        <a class="linux-download" href={releaseHistory} data-linux-release-link>{home.linuxAction}<SiteIcon name="arrow" size={18} /></a>
      </section>
    </div>

    {!compact && <section class="core-update" data-platform-only="windows" data-entry data-category="windows-core-update" data-flavor="all" aria-label={copy.updateTitle}>
      <img src="/images/download-icons/arrow-repeat.svg" alt="" width="31" height="31" />
      <div><strong>{copy.updateTitle}</strong><span>{copy.updateText} · <span data-size>—</span></span></div>
      <div class="option-actions">
        <a data-action="0" data-label={copy.updateAction} hidden aria-disabled="true">{copy.updateAction}</a>
        <a data-action="1" hidden aria-disabled="true"></a>
        <span data-unavailable hidden>{copy.unavailable}</span>
      </div>
    </section>}

    {!compact && <nav class="download-support" aria-label={copy.help}>
      <a href={helpUrl}><img src="/images/download-icons/book.svg" alt="" width="18" height="18" />{copy.help}</a>
      <a href={releaseHistory}><img src="/images/download-icons/clock-history.svg" alt="" width="18" height="18" />{copy.history}</a>
      <a href={releaseHistory}>{copy.openDirect}</a>
    </nav>}
    {compact && <p class="all-downloads"><a href={localeSlug ? `/${localeSlug}/download/` : '/download/'}>{home.allDownloads}<SiteIcon name="arrow" size={18} /></a></p>}

    <noscript><p class="noscript-note"><a href={releaseHistory}>{copy.openDirect}</a></p></noscript>
  </div>
</section>

<script>
  import { initDownloads } from '../lib/download-ui.mjs'
  initDownloads(document)
</script>
