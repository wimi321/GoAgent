    retry: 'โหลดใหม่', openDirect: 'เปิดดาวน์โหลดสำรองบน GitHub', amdMore: 'รุ่นทดลองสำหรับ RX 6000 / RX 7000 / Ryzen AI Max อยู่บน GitHub หากไม่แน่ใจรุ่น ให้ใช้ OpenCL', amdMoreAction: 'รุ่นทดลอง AMD อื่น',
    rows: { nvidia: ['NVIDIA CUDA', 'รุ่นเดียวสำหรับ RTX 20 / 30 / 40 / 50'], amd: ['AMD RX 9000', 'ROCm รุ่นทดลอง · RX 9060 / 9070'], tensorrt: ['TensorRT ทางเลือก', 'RTX 30 / 40 / 50 ควรใช้ CUDA ซึ่งมักเร็วกว่า · TensorRT ใช้เร่ง RTX 20 / GTX 16 เท่านั้น · ไม่รองรับ GTX 10 · ดาวน์โหลดทั้งสองส่วน'], opencl: ['รุ่น OpenCL', 'การ์ดจอ AMD / Intel'], cpu: ['รุ่น CPU', 'ใช้ได้โดยไม่มีการ์ดจอแยก'], noEngine: ['ไม่มีเอนจิน', 'สำหรับ KataGo ของคุณเอง'], apple: ['ชิป Apple', 'M1 / M2 / M3 / M4 / M5'], intel: ['ชิป Intel', 'Mac Intel รุ่นเก่า'] }
