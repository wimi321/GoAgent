const copy = copyByLang[lang] ?? copyByLang.en
const localeSlug = { 'zh-CN': '', 'zh-Hant': 'zh-hant', en: 'en', ja: 'ja', ko: 'ko', th: 'th', vi: 'vi' }[lang]
const helpUrl = localeSlug ? `/${localeSlug}/docs` : '/docs'
const rows = [
  ['nvidia', 'windows-portable', 'nvidia', '', 'gpu-card', true],
  ['rtx50', 'windows-portable', 'nvidia50.cuda', '', 'gpu-card', false],
  ['tensorrt', 'tensorrt-advanced', 'nvidia-tensorrt', '', 'speedometer', false],
  ['opencl', 'windows-portable', 'opencl', '', 'gpu-card', false],
  ['cpu', 'windows-portable', 'with-katago', '', 'cpu', false],
  ['noEngine', 'windows-portable', 'without.engine', '', 'gear', false]
