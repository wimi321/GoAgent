---
import '../styles/site.css'
import SiteIcon from '../components/SiteIcon.astro'
import { homeCopy } from '../data/home-copy.mjs'

interface Props {
  title?: string
  description?: string
  canonical?: string
  lang?: string
  pageKey?:
    | 'home'
    | 'download'
    | 'docs'
    | 'privacy'
    | 'faq'
    | 'changelog'
    | 'katago-review'
    | 'fox-go-review'
    | 'ai-go-review'
    | 'compare'
  jsonLd?: Record<string, unknown>
}

const {
  title = homeCopy['zh-CN'].title,
  description = homeCopy['zh-CN'].description,
  canonical = new URL(Astro.url.pathname, 'https://goagent.top').toString(),
  lang = 'zh-CN',
  pageKey = 'home',
  jsonLd
} = Astro.props

const goAgentReleases = 'https://github.com/wimi321/GoAgent/releases'
const lizzieUrl = 'https://github.com/wimi321/lizzieyzy-next'

const homeByLang = {
  'zh-CN': '/',
  'zh-Hant': '/zh-hant',
  en: '/en',
  ja: '/ja',
  ko: '/ko',
  th: '/th',
  vi: '/vi'
} as const

const localeSlugs = {
  'zh-CN': '',
  'zh-Hant': 'zh-hant',
  en: 'en',
  ja: 'ja',
  ko: 'ko',
  th: 'th',
  vi: 'vi'
} as const

function localizedPath(locale: keyof typeof localeSlugs, key: NonNullable<Props['pageKey']>) {
  const localePrefix = localeSlugs[locale]
  const pageSegment = key === 'home' ? '' : key
  if (!localePrefix && !pageSegment) return '/'
  if (!localePrefix) return `/${pageSegment}`
  return pageSegment ? `/${localePrefix}/${pageSegment}` : `/${localePrefix}`
}

const copyByLang = {
  'zh-CN': {
    skip: '跳到主要内容', home: '首页', download: '下载', cta: '免费下载',
    nav: { features: '功能', docs: '使用指南', faq: '常见问题', changelog: '更新日志' },
    product: '产品', topics: '专题', community: '社区', privacy: '隐私说明', issues: '问题反馈',
    topicLinks: [['/katago-review', 'KataGo 复盘'], ['/fox-go-review', '野狐棋谱复盘'], ['/ai-go-review', '围棋 AI 复盘'], ['/compare', '产品对比']]
  },
  'zh-Hant': {
    skip: '跳到主要內容', home: '首頁', download: '下載', cta: '免費下載',
    nav: { features: '功能', docs: '使用指南', faq: '常見問題', changelog: '更新日誌' },
    product: '產品', topics: '專題', community: '社群', privacy: '隱私說明', issues: '問題回報',
    topicLinks: []
  },
  en: {
    skip: 'Skip to content', home: 'Home', download: 'Download', cta: 'Download',
    nav: { features: 'Features', docs: 'Guide', faq: 'FAQ', changelog: 'Changelog' },
    product: 'Product', topics: 'Topics', community: 'Community', privacy: 'Privacy', issues: 'Report an issue',
    topicLinks: []
  },
  ja: {
    skip: '本文へ移動', home: 'ホーム', download: 'ダウンロード', cta: 'ダウンロード',
    nav: { features: '機能', docs: 'ガイド', faq: 'よくある質問', changelog: '更新履歴' },
    product: '製品', topics: 'トピック', community: 'コミュニティ', privacy: 'プライバシー', issues: '不具合の報告',
    topicLinks: []
  },
  ko: {
    skip: '본문으로 이동', home: '홈', download: '다운로드', cta: '다운로드',
    nav: { features: '기능', docs: '가이드', faq: '자주 묻는 질문', changelog: '변경 기록' },
    product: '제품', topics: '주제', community: '커뮤니티', privacy: '개인정보', issues: '문제 신고',
    topicLinks: []
  },
  th: {
    skip: 'ไปยังเนื้อหา', home: 'หน้าแรก', download: 'ดาวน์โหลด', cta: 'ดาวน์โหลด',
    nav: { features: 'ฟีเจอร์', docs: 'คู่มือ', faq: 'คำถามที่พบบ่อย', changelog: 'บันทึกอัปเดต' },
    product: 'ผลิตภัณฑ์', topics: 'หัวข้อ', community: 'ชุมชน', privacy: 'ความเป็นส่วนตัว', issues: 'แจ้งปัญหา',
    topicLinks: []
  },
  vi: {
    skip: 'Chuyển tới nội dung', home: 'Trang chủ', download: 'Tải xuống', cta: 'Tải xuống',
    nav: { features: 'Tính năng', docs: 'Hướng dẫn', faq: 'Hỏi đáp', changelog: 'Nhật ký' },
    product: 'Sản phẩm', topics: 'Chủ đề', community: 'Cộng đồng', privacy: 'Quyền riêng tư', issues: 'Báo lỗi',
    topicLinks: []
  }
} as const

type SiteLang = keyof typeof copyByLang
const siteLang = (lang in copyByLang ? lang : 'zh-CN') as SiteLang
const copy = copyByLang[siteLang]
const homeHref = homeByLang[siteLang]
const localizedPageKeys = new Set(['home', 'download', 'docs', 'privacy', 'faq', 'changelog'])
const languagePageKey = localizedPageKeys.has(pageKey) ? pageKey : 'home'

const currentLanguageLabels = {
  'zh-CN': '简体中文',
  'zh-Hant': '繁體中文',
  en: 'English',
  ja: '日本語',
  ko: '한국어',
  th: 'ไทย',
  vi: 'Tiếng Việt'
} as const

const pageHref = (key: NonNullable<Props['pageKey']>) => localizedPath(siteLang, key)
const featuresHref = `${homeHref === '/' ? '/' : `${homeHref}/`}#features`
const navItems = [
  { href: featuresHref, label: copy.nav.features, key: 'features' },
  { href: pageHref('docs'), label: copy.nav.docs, key: 'docs' },
  { href: pageHref('faq'), label: copy.nav.faq, key: 'faq' },
  { href: pageHref('changelog'), label: copy.nav.changelog, key: 'changelog' }
]
const downloadHref = `${pageHref('download')}/`
const siteText = homeCopy[siteLang]
const topicLinks: ReadonlyArray<readonly [string, string]> = copy.topicLinks

const alternateItems = localizedPageKeys.has(pageKey)
  ? [
      { lang: 'zh-CN', href: `https://goagent.top${localizedPath('zh-CN', pageKey)}` },
      { lang: 'zh-Hant', href: `https://goagent.top${localizedPath('zh-Hant', pageKey)}` },
      { lang: 'en', href: `https://goagent.top${localizedPath('en', pageKey)}` },
      { lang: 'ja', href: `https://goagent.top${localizedPath('ja', pageKey)}` },
      { lang: 'ko', href: `https://goagent.top${localizedPath('ko', pageKey)}` },
      { lang: 'th', href: `https://goagent.top${localizedPath('th', pageKey)}` },
      { lang: 'vi', href: `https://goagent.top${localizedPath('vi', pageKey)}` },
      { lang: 'x-default', href: `https://goagent.top${localizedPath('zh-CN', pageKey)}` }
    ]
  : []
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content="https://goagent.top/images/og-lizzieyzy-next.jpg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#f7f4ec" />
    <meta name="color-scheme" content="light" />
    {alternateItems.map((item) => <link rel="alternate" hreflang={item.lang} href={item.href} />)}
    <link rel="icon" href="/favicon-48.png" type="image/png" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    {jsonLd && <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <a class="skip-link" href="#content">{copy.skip}</a>
    <div class="site-shell">
      <header class="site-header">
        <a class="site-logo" href={homeHref} aria-label={`LizzieYzy Next · ${copy.home}`}>
          <img src="/images/lizzieyzy-next-icon.png" alt="" width="34" height="34" />
          <span>LizzieYzy Next</span>
        </a>
        <nav class="desktop-nav" aria-label={siteText.nav}>
          {navItems.map((item) => <a href={item.href} aria-current={item.key === pageKey ? 'page' : undefined}>{item.label}</a>)}
        </nav>
        <div class="header-actions">
          <details class="language-menu">
            <summary aria-label={siteText.language}>
              <SiteIcon name="globe" size={18} />
              <span>{currentLanguageLabels[siteLang]}</span>
              <SiteIcon name="chevron" size={12} class="chevron" />
            </summary>
            <div class="language-menu-list">
              {Object.entries(currentLanguageLabels).map(([locale, label]) => <a href={localizedPath(locale as keyof typeof localeSlugs, languagePageKey)} lang={locale} aria-current={locale === siteLang ? 'true' : undefined}>{label}</a>)}
            </div>
          </details>
          <details class="mobile-nav">
            <summary aria-label={siteText.menu}><SiteIcon name="menu" size={24} /></summary>
            <nav aria-label={siteText.nav}>
              <a href={homeHref}>{copy.home}</a>
              <a href={downloadHref}>{copy.download}</a>
              {navItems.map((item) => <a href={item.href}>{item.label}</a>)}
            </nav>
          </details>
          <a class="button primary header-cta" href={downloadHref}>{copy.cta}</a>
        </div>
      </header>
      <main id="content">
        <slot />
      </main>
      <footer class="site-footer">
        <div class="footer-grid">
          <div class="footer-brand">
            <a class="footer-logo" href={homeHref}><img src="/images/lizzieyzy-next-icon.png" alt="" width="34" height="34" /><span>LizzieYzy Next</span></a>
            <p>{siteText.tagline}</p>
            <a class="footer-github" href={lizzieUrl}><SiteIcon name="github" size={17} />GitHub</a>
          </div>
          <nav class="footer-col" aria-label={copy.product}>
            <p class="footer-title">{copy.product}</p>
            <a href={downloadHref}>{copy.download}</a>
            <a href={pageHref('docs')}>{copy.nav.docs}</a>
            <a href={pageHref('faq')}>{copy.nav.faq}</a>
            <a href={pageHref('changelog')}>{copy.nav.changelog}</a>
          </nav>
          {topicLinks.length > 0 && <nav class="footer-col" aria-label={copy.topics}>
            <p class="footer-title">{copy.topics}</p>
            {topicLinks.map(([href, label]) => <a href={href}>{label}</a>)}
          </nav>}
          <div class="footer-col">
            <p class="footer-title">{copy.community}</p>
            <span>LizzieYzy Next QQ 299419120</span>
            <span>GoAgent QQ 1030632742</span>
            <a href={`${lizzieUrl}/issues`}>{copy.issues}</a>
            <a href={goAgentReleases}>{siteText.experimental}</a>
            <a href={pageHref('privacy')}>{copy.privacy}</a>
          </div>
        </div>
        <div class="footer-bottom">
          <p>Copyright © {new Date().getFullYear()} GoAgent and LizzieYzy Next contributors · GPL-3.0</p>
          <p>{siteText.aiNote}</p>
        </div>
      </footer>
    </div>
  </body>
</html>

<script>
  const menus = [...document.querySelectorAll<HTMLDetailsElement>('.site-header details')]
  menus.forEach(menu => {
    menu.addEventListener('toggle', () => { if (menu.open) menus.filter(other => other !== menu).forEach(other => { other.open = false }) })
    menu.addEventListener('keydown', event => { if (event.key === 'Escape') { menu.open = false; menu.querySelector('summary')?.focus() } })
    menu.querySelectorAll('a').forEach(link => link.addEventListener('click', () => { menu.open = false }))
  })
  document.addEventListener('click', event => menus.forEach(menu => { if (!menu.contains(event.target as Node)) menu.open = false }))
</script>
