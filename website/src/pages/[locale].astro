---
import HomePage from '../components/HomePage.astro'
import { localeSlugs } from '../data/home-copy.mjs'
export function getStaticPaths() {
  return Object.entries(localeSlugs).filter(([, slug]) => slug).map(([lang, locale]) => ({ params: { locale }, props: { lang } }))
}
const lang = Astro.props.lang as keyof typeof localeSlugs
---
<HomePage lang={lang} />
