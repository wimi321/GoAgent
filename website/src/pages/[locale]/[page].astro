---
import BaseLayout from '../../layouts/BaseLayout.astro'
import ContentPage from '../../components/ContentPage.astro'
import DownloadChooser from '../../components/DownloadChooser.astro'

const localeKeys = ['zh-hant', 'en', 'ja', 'ko', 'th', 'vi'] as const
const pageKeys = ['download', 'docs', 'privacy', 'faq', 'changelog'] as const
type LocaleKey = (typeof localeKeys)[number]
type PageKey = (typeof pageKeys)[number]

const localeMeta = {
  'zh-hant': { lang: 'zh-Hant' },
  en: { lang: 'en' },
  ja: { lang: 'ja' },
  ko: { lang: 'ko' },
  th: { lang: 'th' },
  vi: { lang: 'vi' }
} as const

const downloadMeta = {
  'zh-hant': { title: '下載 LizzieYzy Next - 選擇 Windows 或 macOS 版本', description: '依顯示卡和 Mac 晶片選擇 LizzieYzy Next，包含 NVIDIA CUDA、AMD RX 9000 ROCm 實驗版、OpenCL、CPU 與 macOS 版本。' },
  en: { title: 'Download LizzieYzy Next for Windows or macOS', description: 'Choose the right LizzieYzy Next build for NVIDIA CUDA, experimental AMD RX 9000 ROCm, OpenCL, CPU, Apple silicon, or Intel Mac.' },
  ja: { title: 'LizzieYzy Next ダウンロード - Windows / macOS', description: 'NVIDIA CUDA、AMD RX 9000 ROCm 実験版、OpenCL、CPU、Apple シリコン、Intel Mac に合う版を選べます。' },
  ko: { title: 'LizzieYzy Next 다운로드 - Windows / macOS', description: 'NVIDIA CUDA, AMD RX 9000 ROCm 실험판, OpenCL, CPU, Apple 실리콘 또는 Intel Mac에 맞는 버전을 선택하세요.' },
  th: { title: 'ดาวน์โหลด LizzieYzy Next สำหรับ Windows หรือ macOS', description: 'เลือกรุ่น LizzieYzy Next สำหรับ NVIDIA CUDA, AMD RX 9000 ROCm รุ่นทดลอง, OpenCL, CPU, Apple silicon หรือ Intel Mac' },
  vi: { title: 'Tải LizzieYzy Next cho Windows hoặc macOS', description: 'Chọn bản LizzieYzy Next phù hợp cho NVIDIA CUDA, AMD RX 9000 ROCm thử nghiệm, OpenCL, CPU, Apple silicon hoặc Intel Mac.' }
} as const

// getStaticPaths runs in its own scope, so it lists the locales and pages itself.
export function getStaticPaths() {
  const locales = ['zh-hant', 'en', 'ja', 'ko', 'th', 'vi'] as const
  const pages = ['download', 'docs', 'privacy', 'faq', 'changelog'] as const
  return locales.flatMap((locale) => pages.map((page) => ({ params: { locale, page } })))
}

const locale = Astro.params.locale as LocaleKey
const page = Astro.params.page as PageKey
const meta = localeMeta[locale]
const canonical = `https://goagent.top/${locale}/${page}`
---
{page === 'download' ? (
  <BaseLayout title={downloadMeta[locale].title} description={downloadMeta[locale].description} lang={meta.lang} canonical={canonical} pageKey="download">
    <DownloadChooser lang={meta.lang} />
  </BaseLayout>
) : (
  <ContentPage lang={meta.lang} page={page} canonical={canonical} />
)}
