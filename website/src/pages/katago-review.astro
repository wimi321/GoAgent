---
import BaseLayout from '../layouts/BaseLayout.astro'

const features = [
  ['先看整盘', '胜率曲线和问题手清单一起看，先找出真正改变局面的几手，不用每一手都重算。'],
  ['再看推荐点', '在关键手附近展开 KataGo 推荐点和变化图，看清哪里亏了、哪里其实可以接受。'],
  ['三个平台都能用', 'Windows、macOS、Linux 都有完整包，下载后就能开始。']
]

const faq = [
  ['KataGo 复盘用什么软件？', '可以用 LizzieYzy Next。它免费开源，自带 KataGo 引擎和默认权重，打开棋谱就能分析整盘。'],
  ['需要自己配置 KataGo 吗？', '不需要。完整包第一次打开会自动配置；已经有自己的 KataGo，也可以下载无引擎版。'],
  ['我该下载哪个版本？', 'Windows 按显卡选：NVIDIA RTX 20 / 30 / 40 / 50 选 CUDA 版，AMD、Intel 或较旧的 NVIDIA 显卡选 OpenCL 版，没有独立显卡选 CPU 版；Mac 按芯片选择。']
]

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'SoftwareApplication',
      name: 'LizzieYzy Next',
      applicationCategory: 'GameApplication',
      operatingSystem: 'Windows, macOS, Linux',
      url: 'https://goagent.top/katago-review',
      downloadUrl: 'https://goagent.top/download/',
      description: 'LizzieYzy Next 是免费开源的围棋复盘软件，自带 KataGo。',
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' }
    },
    {
      '@type': 'FAQPage',
      mainEntity: faq.map(([question, answer]) => ({
        '@type': 'Question',
        name: question,
        acceptedAnswer: { '@type': 'Answer', text: answer }
      }))
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: '首页', item: 'https://goagent.top/' },
        { '@type': 'ListItem', position: 2, name: 'KataGo 复盘', item: 'https://goagent.top/katago-review' }
      ]
    }
  ]
}
---
<BaseLayout
  title="KataGo 复盘软件 - LizzieYzy Next 免费围棋 AI 复盘"
  description="想用 KataGo 复盘围棋？LizzieYzy Next 自带 KataGo，打开棋谱一键分析整盘，看胜率曲线、推荐点和问题手。免费开源，支持 Windows、macOS、Linux。"
  pageKey="katago-review"
  jsonLd={jsonLd}
>
  <section class="page-hero">
    <p class="eyebrow">KataGo 复盘</p>
    <h1>KataGo 复盘，先把整盘看清楚</h1>
    <p class="lead">复盘真正要回答的是两件事：这盘棋从哪里开始变坏，下次该怎么下。LizzieYzy Next 自带 KataGo，打开棋谱就能找到答案。</p>
    <div class="button-row">
      <a class="button primary" href="/download/">免费下载</a>
      <a class="button subtle" href="/docs">查看使用指南</a>
    </div>
  </section>

  <section class="content-stack">
    <article class="premium-panel doc-card">
      <div>
        <h2>自带 KataGo，打开就能分析</h2>
        <p>完整包内置 KataGo 引擎和默认权重，第一次打开自动配置。打开棋谱，在“分析”菜单选择“整盘速览”，胜率曲线、推荐点和问题手清单就都有了。</p>
      </div>
      <img src="/images/lizzie-earred-127.webp" alt="LizzieYzy Next 真实界面：整盘胜率曲线、问题手清单和棋盘上的 KataGo 推荐点" width="2400" height="1408" loading="lazy" decoding="async" />
    </article>

    <div class="grid three">
      {features.map(([title, text]) => (
        <article class="doc-card">
          <h2>{title}</h2>
          <p>{text}</p>
        </article>
      ))}
    </div>

    <section class="faq-list" aria-label="KataGo 复盘常见问题">
      {faq.map(([question, answer]) => (
        <details>
          <summary>{question}</summary>
          <p>{answer}</p>
        </details>
      ))}
    </section>
  </section>
</BaseLayout>
