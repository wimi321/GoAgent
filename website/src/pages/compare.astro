---
import BaseLayout from '../layouts/BaseLayout.astro'

const goAgentReleases = 'https://github.com/wimi321/GoAgent/releases'

const rows = [
  ['适合谁', '想稳定复盘的绝大多数棋友', '想尝试 AI 自然语言讲棋的用户'],
  ['主要功能', 'KataGo 整盘分析、胜率曲线、推荐点、问题手、AI 解说与 AI 陪练', '把棋盘、KataGo 分析和 AI 问答组织成讲解流程'],
  ['状态', '正式版，适合日常使用', '实验项目，适合尝鲜和反馈'],
  ['平台', 'Windows / macOS / Linux', 'Windows / macOS']
]

const faq = [
  ['第一次来应该下载哪个？', '下载 LizzieYzy Next。复盘需要的功能它都有，包括 AI 解说和 AI 陪练。'],
  ['GoAgent 还值得试吗？', '值得。如果你对 AI 讲棋感兴趣，愿意尝鲜并反馈问题，可以试试 GoAgent。'],
  ['两个软件能一起装吗？', '可以，它们是两个独立的软件。']
]

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      name: 'LizzieYzy Next 和 GoAgent 有什么区别',
      inLanguage: 'zh-CN',
      description: 'LizzieYzy Next 是免费开源的围棋复盘软件；GoAgent 是探索 AI 讲棋的实验项目。',
      url: 'https://goagent.top/compare'
    },
    {
      '@type': 'FAQPage',
      mainEntity: faq.map(([question, answer]) => ({
        '@type': 'Question',
        name: question,
        acceptedAnswer: { '@type': 'Answer', text: answer }
      }))
    }
  ]
}
---
<BaseLayout
  title="LizzieYzy Next 和 GoAgent 有什么区别"
  description="想复盘围棋，下载 LizzieYzy Next 就够了：免费开源，自带 KataGo、AI 解说和 AI 陪练。GoAgent 是探索 AI 讲棋的实验项目。"
  pageKey="compare"
  jsonLd={jsonLd}
>
  <section class="page-hero">
    <p class="eyebrow">产品对比</p>
    <h1>复盘用 LizzieYzy Next，想尝鲜再试 GoAgent</h1>
    <p class="lead">两个项目都和围棋 AI 有关，但目标不同：LizzieYzy Next 是成熟的复盘软件，GoAgent 是探索 AI 讲棋的实验项目。</p>
    <div class="button-row">
      <a class="button primary" href="/download/">下载 LizzieYzy Next</a>
      <a class="button subtle" href={goAgentReleases}>了解 GoAgent</a>
    </div>
  </section>

  <section class="content-stack">
    <div class="grid two">
      <article class="product-panel featured">
        <img src="/images/lizzie-earred-127.webp" alt="LizzieYzy Next 真实界面" width="2400" height="1408" loading="lazy" decoding="async" />
        <div class="product-copy">
          <p class="product-label">正式版</p>
          <h2>LizzieYzy Next</h2>
          <p>适合绝大多数棋友：打开棋谱，看清胜率走势、推荐点和问题手，还能用 AI 解说和 AI 陪练。</p>
        </div>
      </article>
      <article class="product-panel">
        <div class="product-mark" aria-hidden="true"><i></i><i></i></div>
        <div class="product-copy">
          <p class="product-label">实验项目</p>
          <h2>GoAgent</h2>
          <p>适合想体验 AI 讲棋的用户：把棋盘、KataGo 分析和自然语言解释放进一个实验性的讲解流程。</p>
        </div>
      </article>
    </div>

    <article class="doc-card">
      <h2>快速对比</h2>
      <div class="compare-table" role="table" aria-label="LizzieYzy Next 与 GoAgent 对比">
        <div class="compare-row compare-head" role="row">
          <strong role="columnheader">对比项</strong>
          <strong role="columnheader">LizzieYzy Next</strong>
          <strong role="columnheader">GoAgent</strong>
        </div>
        {rows.map(([label, lizzie, goagent]) => (
          <div class="compare-row" role="row">
            <strong role="cell">{label}</strong>
            <span role="cell">{lizzie}</span>
            <span role="cell">{goagent}</span>
          </div>
        ))}
      </div>
    </article>

    <section class="faq-list" aria-label="产品选择常见问题">
      {faq.map(([question, answer]) => (
        <details>
          <summary>{question}</summary>
          <p>{answer}</p>
        </details>
      ))}
    </section>
  </section>
</BaseLayout>
