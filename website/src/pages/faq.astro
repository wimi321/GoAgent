---
import BaseLayout from '../layouts/BaseLayout.astro'
import { guideCopy } from '../data/guide-copy.mjs'

const faqs = [
  ['我应该先下载哪个？', '先下载 LizzieYzy Next。它是首推的稳定复盘工具，适合大多数棋友日常看胜率、目差和关键失误。'],
  ['我该点哪个下载？', '直接进入官网下载中心。NVIDIA RTX 20 / 30 / 40 / 50 选 CUDA 版，AMD、Intel 或旧 NVIDIA 显卡选 OpenCL 版，没有合适独立显卡再选 CPU 版。'],
  ['GoAgent 要不要一起下载？', guideCopy['zh-CN'].separate],
  ['下载后我该做什么？', '安装 LizzieYzy Next，打开或导入 SGF 棋谱，然后先看胜率曲线、目差变化和关键失误。'],
  ['支持哪些电脑？', 'LizzieYzy Next 支持 Windows、macOS、Linux。GoAgent 目前更适合想尝鲜的 Windows / macOS 用户。'],
  ['需要看英文 GitHub 页面吗？', '普通用户不需要。官网下载中心已经把稳定版按电脑类型整理好，直接点击对应版本即可。'],
  ['安装包从哪里下载？', '官网下载中心会提供当前稳定版的直接下载按钮；历史版本和开源代码仍可从 GitHub 查看。'],
  ['会不会上传我的棋谱？', guideCopy['zh-CN'].privacy],
  ['KataGo、AI、LLM 这些词我不懂怎么办？', '不用先懂。日常复盘先看胜率、目差和推荐点就够了；想听解释时，再连接自己的 AI 服务。'],
  ['如何反馈问题？', '可以在 GitHub Issues 反馈，也欢迎加入 GoAgent QQ 1030632742 或 LizzieYzy Next QQ 299419120 交流。']
]

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(([question, answer]) => ({
    '@type': 'Question',
    name: question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: answer
    }
  }))
}
---
<BaseLayout title="常见问题 - LizzieYzy Next 和 GoAgent" description="普通用户常见问题：该下载哪个、怎么选择电脑版本、GoAgent 是否必须、隐私和反馈方式。" pageKey="faq" jsonLd={jsonLd}>
  <section class="page-hero">
    <h1>常见问题</h1>
    <p class="lead">不讲复杂术语，先回答最常见的问题：下载哪个、点哪里、装完怎么开始、GoAgent 要不要用。</p>
  </section>
  <section class="content-stack faq-list">
    {faqs.map(([question, answer]) => (
      <details>
        <summary>{question}</summary>
        <p>{answer}</p>
      </details>
    ))}
  </section>
</BaseLayout>
