---
import DownloadChooser from '../components/DownloadChooser.astro'
import BaseLayout from '../layouts/BaseLayout.astro'

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'LizzieYzy Next',
  applicationCategory: 'GameApplication',
  operatingSystem: 'Windows, macOS',
  downloadUrl: 'https://goagent.top/download',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' }
}
---

<BaseLayout
  title="下载 LizzieYzy Next - 选择 Windows 或 macOS 版本"
  description="按显卡和 Mac 芯片选择 LizzieYzy Next。提供 NVIDIA、RTX 50、TensorRT、OpenCL、CPU、无引擎与 Apple Silicon、Intel 版本。"
  pageKey="download"
  jsonLd={jsonLd}
>
  <DownloadChooser lang="zh-CN" />
</BaseLayout>
