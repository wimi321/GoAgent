---
import BaseLayout from '../layouts/BaseLayout.astro'

const steps = [
  ['按昵称抓谱', '不用记账号数字，输入野狐昵称就能找到最近的公开对局。'],
  ['一键分析整盘', '用“整盘速览”很快看完整盘；想算得更细，用“整盘精析”。'],
  ['盯住问题手', '问题手按胜率损失排好序，点一下跳过去，对照 KataGo 推荐点看懂。']
]

const faq = [
  ['野狐棋谱怎么导入 LizzieYzy Next？', '点工具栏的“野狐棋谱”，输入野狐昵称，就能找到最近的公开对局，选中一盘即可打开。'],
  ['需要知道野狐账号的数字 ID 吗？', '不需要，输入昵称就行。'],
  ['抓下来的棋谱可以保存吗？', '可以，保存为 SGF 棋谱后随时都能再打开复盘。']
]

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'TechArticle',
      headline: '野狐棋谱复盘怎么做',
      inLanguage: 'zh-CN',
      description: '在 LizzieYzy Next 里输入野狐昵称抓取棋谱，用 KataGo 分析整盘并找出问题手。',
      mainEntityOfPage: 'https://goagent.top/fox-go-review'
    },
    {
      '@type': 'FAQPage',
      mainEntity: faq.map(([question, answer]) => ({
        '@type': 'Question',
        name: question,
        acceptedAnswer: { '@type': 'Answer', text: answer }
      }))
    }
  ]
}
---
<BaseLayout
  title="野狐棋谱复盘 - 输入昵称抓谱，KataGo 找出问题手 | LizzieYzy Next"
  description="野狐棋谱怎么复盘？在 LizzieYzy Next 里输入野狐昵称就能抓取最近的公开对局，一键分析整盘，找出胜率掉得最多的问题手。"
  pageKey="fox-go-review"
  jsonLd={jsonLd}
>
  <section class="page-hero">
    <p class="eyebrow">野狐棋谱复盘</p>
    <h1>野狐棋谱复盘，输入昵称就够了</h1>
    <p class="lead">下完一盘野狐，最想知道的是从哪里开始亏、哪几手值得重看。LizzieYzy Next 能直接按昵称抓谱，分析完整盘，再把问题手列给你。</p>
    <div class="button-row">
      <a class="button primary" href="/download/">免费下载</a>
      <a class="button subtle" href="/katago-review">了解 KataGo 复盘</a>
    </div>
  </section>

  <section class="content-stack">
    <article class="premium-panel doc-card">
      <div>
        <h2>从抓谱到看懂问题手</h2>
        <p>点工具栏的“野狐棋谱”，输入野狐昵称，选一盘最近的公开对局打开；再用“整盘速览”分析整盘，左侧的问题手清单会按胜率损失排好序。</p>
      </div>
      <img class="panel-shot-tall" src="/images/lizzie-curve-problems.webp" alt="LizzieYzy Next 真实界面：整盘胜率曲线和按胜率损失排序的问题手清单" width="730" height="1280" loading="lazy" decoding="async" />
    </article>

    <ol class="step-cards">
      {steps.map(([title, text], index) => (
        <li class="doc-card step-card">
          <span class="step-index" aria-hidden="true">{index + 1}</span>
          <div>
            <h2>{title}</h2>
            <p>{text}</p>
          </div>
        </li>
      ))}
    </ol>

    <section class="faq-list" aria-label="野狐棋谱复盘常见问题">
      {faq.map(([question, answer]) => (
        <details>
          <summary>{question}</summary>
          <p>{answer}</p>
        </details>
      ))}
    </section>
  </section>
</BaseLayout>
